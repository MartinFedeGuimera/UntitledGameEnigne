<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Shaders\shader.frag" />
    <None Remove="Resources\Shaders\shader.vert" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Shaders\shader.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Shaders\shader.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UntitledGameEngine">
      <HintPath>..\..\..\UntitledGameEngine\bin\Debug\net8.0\UntitledGameEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
